<Window x:Class="Nexus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="DLSS Nexus" Icon="Brand/nexus.ico" Width="1120" Height="820" MinWidth="980" MinHeight="680"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Closing="Window_Closing" Loaded="Window_Loaded" SourceInitialized="Window_SourceInitialized" Closed="Window_Closed">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" /></shell:WindowChrome.WindowChrome>
  <Border BorderBrush="{StaticResource Line}" BorderThickness="1">
    <Grid>
      <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#0D1626" Offset="0" /><GradientStop Color="#080D16" Offset="0.6" /><GradientStop Color="#161025" Offset="1" /></LinearGradientBrush></Grid.Background>
      <Grid.RowDefinitions><RowDefinition Height="40" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid Background="#090F1A">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False"><Image Source="Brand/nexus-mark.png" Width="20" Height="20" Margin="0,0,9,0" /><TextBlock Text="DLSS Nexus" Foreground="{StaticResource Muted}" FontSize="12" /></StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button x:Name="MinimizeButton" Style="{StaticResource ChromeButton}" Click="Minimize_Click" AutomationProperties.Name="Minimize"><Path Data="M 0,0 L 10,0" Stroke="{StaticResource Muted}" /></Button>
          <Button x:Name="MaximizeButton" Style="{StaticResource ChromeButton}" Click="Maximize_Click" AutomationProperties.Name="Maximize or restore"><Path Data="M 0,0 L 10,0 L 10,10 L 0,10 Z" Stroke="{StaticResource Muted}" /></Button>
          <Button x:Name="CloseButton" Style="{StaticResource ChromeButton}" Click="Close_Click" AutomationProperties.Name="Close"><Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="{StaticResource Danger}" StrokeThickness="1.4" /></Button>
        </StackPanel>
      </Grid>
      <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="24,15">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <Image Source="Brand/nexus-mark.png" Width="54" Height="54" Margin="0,0,16,0" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="DLSS Nexus" FontFamily="Bahnschrift, Segoe UI" FontSize="26" FontWeight="SemiBold" /><TextBlock Text="DLSS 5 &amp; game library" Style="{StaticResource Hint}" FontSize="12" /></StackPanel>
          <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="1.0.0 / WINDOWS x64" Foreground="{StaticResource Violet}" FontFamily="{StaticResource TechnicalFont}" FontSize="11" HorizontalAlignment="Right" /><CheckBox x:Name="AnimateTransitionsBox" Content="Animations" IsChecked="True" Click="TransitionsChanged" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" Margin="0,6,0,0" /></StackPanel>
        </Grid>
      </Border>
      <UniformGrid Grid.Row="2" Rows="1" Columns="4" Margin="24,14,24,0">
        <Button x:Name="StepGameButton" Content="01 / GAMES" Tag="Game" Click="Step_Click" FontFamily="{StaticResource TechnicalFont}" />
        <Button x:Name="StepComponentsButton" Content="02 / SETUP" Tag="Components" Click="Step_Click" FontFamily="{StaticResource TechnicalFont}" IsEnabled="False" />
        <Button x:Name="StepReviewButton" Content="03 / REVIEW" Tag="Review" Click="Step_Click" FontFamily="{StaticResource TechnicalFont}" IsEnabled="False" />
        <Button x:Name="StepCompleteButton" Content="04 / READY" Tag="Complete" Click="Step_Click" FontFamily="{StaticResource TechnicalFont}" IsEnabled="False" Margin="0" />
      </UniformGrid>
      <Grid x:Name="PageHost" Grid.Row="3" Margin="24,16" ClipToBounds="True">
        <Border x:Name="GamePage" Style="{StaticResource Card}">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <TextBlock Text="Your games" FontFamily="Bahnschrift, Segoe UI" FontSize="22" FontWeight="SemiBold" />
              <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12"><Button x:Name="LibraryModeButton" Content="All games" Tag="library" Click="GameMode_Click" /><Button x:Name="ManagedModeButton" Content="Tracked" Tag="tracked" Click="GameMode_Click" /><Button x:Name="ManualModeButton" Content="Add game…" Tag="manual" Click="GameMode_Click" Margin="0" /></StackPanel>
              <Grid x:Name="LibraryPanel" Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid Margin="0,0,10,0"><TextBox x:Name="GameFilterBox" TextChanged="GameFilterChanged" AutomationProperties.Name="Search games" ToolTip="Title or launcher" /><TextBlock x:Name="GameSearchHint" Text="Search games…" Foreground="{StaticResource Muted}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="12,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=GameFilterBox}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><Button x:Name="RefreshGamesButton" Grid.Column="1" Content="Refresh" Click="RefreshGames_Click" Margin="0" /></Grid>
                <ListBox x:Name="InstalledGamesList" Grid.Row="1" SelectionChanged="LibrarySelectionChanged" AutomationProperties.Name="Games"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Status}" Foreground="{StaticResource Accent}" FontSize="11" Margin="0,3,0,0" /><TextBlock Text="{Binding Source}" Foreground="{StaticResource Muted}" FontSize="11" ToolTip="{Binding Root}" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
                <TextBlock x:Name="LibraryStatusText" Grid.Row="2" Text="Loading games…" Style="{StaticResource Hint}" FontSize="11" Margin="0,8,0,0" />
              </Grid>
              <Grid x:Name="ManualPanel" Grid.Row="2" Visibility="Collapsed" VerticalAlignment="Top"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="Choose the game folder or executable." Style="{StaticResource Hint}" Margin="0,0,0,12" /><TextBox x:Name="GamePathBox" Grid.Row="1" TextChanged="InputsChanged" AutomationProperties.Name="Game folder or executable" FontSize="12" />
                <WrapPanel Grid.Row="2" Margin="0,12,0,0"><Button x:Name="BrowseFolderButton" Content="Folder…" Click="BrowseFolder_Click" /><Button x:Name="BrowseExeButton" Content="Executable…" Click="BrowseExe_Click" /><Button x:Name="ScanButton" Content="Find game" Click="Scan_Click" Style="{StaticResource PrimaryButton}" /></WrapPanel>
              </Grid>
              <ListBox x:Name="TargetsList" Grid.Row="3" Margin="0,10,0,0" MaxHeight="90" SelectionChanged="TargetChanged" AutomationProperties.Name="Game executables"><ListBox.Style><Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}"><Style.Triggers><Trigger Property="HasItems" Value="False"><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers></Style></ListBox.Style><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" ToolTip="{Binding Executable}" /></DataTemplate></ListBox.ItemTemplate></ListBox>
              <TextBlock x:Name="DiscoveryText" Grid.Row="4" Text="Select a game to get started." Style="{StaticResource Hint}" FontSize="11" Margin="0,8,0,0" />
            </Grid>
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="0,0,8,0">
                <TextBlock x:Name="InventoryTitle" Text="Game details" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="InventoryStatusText" Text="Select a game to see its DLSS setup." Style="{StaticResource Hint}" FontSize="11" Margin="0,6,0,12" />
                <TextBlock x:Name="LibraryErrorText" Foreground="{StaticResource Warning}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" />
                <TextBlock x:Name="ConfigurationText" Style="{StaticResource Hint}" FontSize="11" Margin="0,0,0,8" />
                <WrapPanel><Button x:Name="LaunchGameButton" Content="Launch game" Click="LaunchGame_Click" IsEnabled="False" Style="{StaticResource PrimaryButton}" /><Button x:Name="CheckStatusButton" Content="Check status" Click="CheckStatus_Click" IsEnabled="False" /></WrapPanel>
                <TextBlock x:Name="GameLaunchHint" Text="Select a game to launch it." Style="{StaticResource Hint}" FontSize="11" Margin="0,6,0,0" />
                <TextBlock x:Name="GameLaunchStatusText" Style="{StaticResource LaunchStatus}" />
                <TextBlock Text="INSTALLED VERSIONS" Style="{StaticResource SectionLabel}" Margin="0,16,0,8" />
                <ItemsControl x:Name="VersionsList"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,8"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" /><TextBlock Text="{Binding Version}" Foreground="{StaticResource Accent}" FontSize="11" TextWrapping="Wrap" /><TextBlock Text="{Binding VersionSource}" Style="{StaticResource Hint}" FontSize="10" ToolTip="{Binding Path}" /><TextBlock Text="Invalid file" Foreground="{StaticResource Warning}" FontSize="11"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="Invalid file"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <TextBlock Text="FEATURES" Style="{StaticResource SectionLabel}" Margin="0,12,0,8" />
                <ItemsControl x:Name="FeaturesList"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontSize="12" /><TextBlock Text="{Binding Component}" Style="{StaticResource Hint}" FontSize="10" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding InGame}" FontSize="11" Foreground="{StaticResource Accent}" ToolTip="{Binding Evidence}" VerticalAlignment="Center" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <Expander x:Name="FeatureReportExpander" Header="Record in-game settings" Margin="0,10,0,0" IsEnabled="False"><StackPanel><TextBlock Text="Record what you checked in the game. These are your reports, not live telemetry." Style="{StaticResource Hint}" FontSize="11" Margin="0,8" /><ComboBox x:Name="ReportedFeatureBox" SelectedIndex="0" AutomationProperties.Name="Feature to record"><ComboBoxItem Content="Super Resolution" Tag="sr" /><ComboBoxItem Content="Ray Reconstruction" Tag="rr" /><ComboBoxItem Content="Frame Generation" Tag="fg" /><ComboBoxItem Content="Neural Rendering" Tag="nr" /></ComboBox><ComboBox x:Name="ReportedStateBox" SelectedIndex="0" Margin="0,8,0,0" AutomationProperties.Name="In-game feature setting"><ComboBoxItem Content="Not checked" Tag="NotChecked" /><ComboBoxItem Content="Enabled" Tag="Enabled" /><ComboBoxItem Content="Disabled" Tag="Disabled" /></ComboBox><Button x:Name="SaveFeatureButton" Content="Save setting" Click="SaveFeature_Click" Margin="0,8,0,0" /></StackPanel></Expander>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Border>
        <Border x:Name="ComponentsPage" Style="{StaticResource Card}" Visibility="Collapsed">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <TextBlock Text="Set up DLSS 5" FontFamily="Bahnschrift, Segoe UI" FontSize="22" FontWeight="SemiBold" /><TextBlock x:Name="ComponentsTargetText" Grid.Row="1" Style="{StaticResource Hint}" FontSize="12" Margin="0,6,0,14" TextTrimming="CharacterEllipsis" />
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="OptionsPanel" Margin="0,0,8,0">
              <TextBlock Text="Does this game have DLSS in its graphics settings?" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
              <ComboBox x:Name="RouteBox" SelectedIndex="0" SelectionChanged="RouteChanged" AutomationProperties.Name="DLSS setup"><ComboBoxItem Content="Choose an option…" Tag="unknown" /><ComboBoxItem Content="Yes — use the game's DLSS" Tag="native" /><ComboBoxItem Content="No — use Feeder" Tag="feeder" /></ComboBox>
              <TextBlock x:Name="RouteHelpText" Text="Check the game's graphics settings if you're unsure." Style="{StaticResource Hint}" FontSize="12" Margin="0,8,0,14" />
              <TextBlock x:Name="ReShadeStateText" Style="{StaticResource Hint}" FontSize="12" /><TextBlock x:Name="ReShadeUpdateText" Style="{StaticResource Hint}" FontSize="11" Margin="0,4,0,12" />

              <TextBlock x:Name="RuntimeKeptText" Text="Your existing neural runtime will be kept." Style="{StaticResource Hint}" FontSize="12" Visibility="Collapsed" />
              <TextBlock x:Name="ApiRequiredText" Text="DirectX version unknown. Select it under Advanced." Foreground="{StaticResource Warning}" TextWrapping="Wrap" FontSize="12" Visibility="Collapsed" Margin="0,10,0,0" />
            <TextBlock x:Name="Dx10SetupText" Text="DirectX 10 Feeder (beta) uses a separate 64-bit helper and RenoDX Generic in host64. Native DLSS setup is DX11/DX12 only." Foreground="{StaticResource Warning}" TextWrapping="Wrap" FontSize="12" Visibility="Collapsed" Margin="0,10,0,0" />
              <TextBlock Text="Single-player games only. Do not use with anti-cheat. Close the game before installing." Foreground="{StaticResource Warning}" TextWrapping="Wrap" FontSize="12" Margin="0,12" />
              <Expander x:Name="AdvancedExpander" Header="Advanced" Margin="0,8,0,0"><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Add-on" Style="{StaticResource Hint}" Margin="0,0,0,6" /><ComboBox x:Name="ProfileBox" SelectedIndex="0" SelectionChanged="ProfileChanged" AutomationProperties.Name="Add-on build"><ComboBoxItem Content="Standard — ShortFuse" Tag="default" /><ComboBoxItem Content="Custom — testing" Tag="experimental" /><ComboBoxItem Content="Legacy — RenoDX Generic v4.7" Tag="legacy" /></ComboBox><Button x:Name="CustomAddonButton" Content="Choose custom add-on…" Click="CustomAddon_Click" IsEnabled="False" Margin="0,10,0,0" /><TextBlock x:Name="CustomAddonText" Text="No custom add-on selected." Style="{StaticResource Hint}" FontSize="11" Margin="0,6,0,10" /><CheckBox x:Name="ReplaceBox" Content="Replace existing add-ons" Click="OptionsChanged" /><CheckBox x:Name="ReplaceNrBox" Content="Also replace the neural runtime" Click="OptionsChanged" IsEnabled="False" /><TextBlock Text="Replaced files are backed up. Existing Super Resolution and game settings are kept." Style="{StaticResource Hint}" FontSize="11" /></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="DirectX version" Style="{StaticResource Hint}" Margin="0,0,0,6" /><ComboBox x:Name="ApiBox" SelectedIndex="0" SelectionChanged="ApiChanged" AutomationProperties.Name="DirectX version"><ComboBoxItem Content="Auto" Tag="Unknown" /><ComboBoxItem Content="DirectX 11" Tag="Direct3D11" /><ComboBoxItem Content="DirectX 12" Tag="Direct3D12" /><ComboBoxItem Content="DirectX 10 - Feeder (beta)" Tag="Direct3D10" /></ComboBox><TextBlock Text="Use the version selected in the game's settings." Style="{StaticResource Hint}" FontSize="11" Margin="0,6,0,10" /><Button x:Name="CheckReShadeButton" Content="Check ReShade updates" Click="CheckReShade_Click" Margin="0" /></StackPanel>
              </Grid></Expander>
            </StackPanel></ScrollViewer>
          </Grid>
        </Border>
        <Border x:Name="ReviewPage" Style="{StaticResource Card}" Visibility="Collapsed">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Ready to install?" FontFamily="Bahnschrift, Segoe UI" FontSize="22" FontWeight="SemiBold" /><Button x:Name="PreviewButton" Grid.Column="1" Content="Recheck" Click="Preview_Click" IsEnabled="False" Margin="0" /></Grid>
            <TextBlock x:Name="PlanText" Style="{StaticResource Hint}" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,4" /><TextBlock x:Name="PlanPathText" Style="{StaticResource Hint}" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,0,14" />
            <Border x:Name="ReviewBlockersCard" Background="#241620" BorderBrush="{StaticResource Danger}" BorderThickness="1" Padding="16" Margin="0,0,0,14" Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive">
              <StackPanel><TextBlock Text="Installation blocked" Foreground="{StaticResource Danger}" FontWeight="SemiBold" FontSize="16" /><TextBlock x:Name="ReviewErrorsText" TextWrapping="Wrap" FontSize="12" LineHeight="20" Margin="0,8,0,0" />
                <StackPanel x:Name="FeederResolutionPanel" Visibility="Collapsed" Margin="0,12,0,0"><TextBlock Text="Nexus can turn off Feeder in the active preset during installation. The original preset is backed up; your other effects and settings are retained." Style="{StaticResource Hint}" FontSize="12" /><Button x:Name="DisableFeederButton" Content="Turn off Feeder for this setup" Click="DisableFeeder_Click" HorizontalAlignment="Left" Margin="0,10,0,0" Visibility="Collapsed" /></StackPanel>
              </StackPanel>
            </Border>
            <Border Background="{StaticResource SurfaceRaised}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="16"><TextBlock x:Name="ReviewSummaryText" TextWrapping="Wrap" FontSize="14" LineHeight="25" /></Border>
            <TextBlock x:Name="ReviewText" Foreground="{StaticResource Warning}" TextWrapping="Wrap" FontSize="12" LineHeight="19" Margin="0,14,0,8" />
            <Expander x:Name="FileDetailsExpander" Header="File details" Margin="0,8,0,0"><DataGrid x:Name="PlanGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" Height="220" FontSize="11" RowHeight="32" AutomationProperties.Name="Installation files"><DataGrid.Columns><DataGridTextColumn Header="ACTION" Binding="{Binding OperationText}" Width="140" /><DataGridTextColumn Header="FILE" Binding="{Binding Component}" Width="180" /><DataGridTextColumn Header="LOCATION" Binding="{Binding Destination}" Width="*" MinWidth="180"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis" /><Setter Property="ToolTip" Value="{Binding Destination}" /></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn></DataGrid.Columns></DataGrid></Expander>
            <Expander x:Name="ActivityExpander" Header="Activity log" Margin="0,12,0,0"><TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="100" FontFamily="{StaticResource TechnicalFont}" FontSize="11" /></Expander>
          </StackPanel></ScrollViewer>
        </Border>
        <Border x:Name="CompletePage" Style="{StaticResource Card}" Visibility="Collapsed"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
          <Border x:Name="CompletionCard" Background="#14251D" BorderBrush="{StaticResource Lime}" BorderThickness="1" Padding="24" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"><StackPanel><TextBlock x:Name="CompletionTitle" Text="Installed" FontFamily="Bahnschrift, Segoe UI" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource Lime}" /><TextBlock x:Name="CompletionDetails" TextWrapping="Wrap" FontSize="13" Margin="0,8,0,0" /></StackPanel></Border>
          <Button x:Name="LaunchCompletedGameButton" Content="Launch game" Click="LaunchCompletedGame_Click" IsEnabled="False" HorizontalAlignment="Left" Margin="0,14,0,0" Style="{StaticResource PrimaryButton}" />
          <TextBlock x:Name="CompletionLaunchHint" Style="{StaticResource Hint}" FontSize="11" Margin="0,6,0,0" />
          <TextBlock x:Name="CompletionLaunchStatusText" Style="{StaticResource LaunchStatus}" />
          <TextBlock x:Name="CompletionWarningText" Foreground="{StaticResource Warning}" TextWrapping="Wrap" FontSize="12" Margin="0,12,0,0" /><TextBlock Text="FINISH IN THE GAME" Style="{StaticResource SectionLabel}" Margin="0,22,0,10" /><TextBlock x:Name="CompletionStepsText" Style="{StaticResource Hint}" FontSize="13" LineHeight="26" />
          <TextBlock Text="Check that Neural Rendering is active in the add-on panel. You can record your settings in Games." Style="{StaticResource Hint}" FontSize="12" Margin="0,14,0,18" />
          <WrapPanel><Button x:Name="OpenGameFolderButton" Content="Game folder" Click="OpenGameFolder_Click" /><Button x:Name="OpenBackupButton" Content="Backups" Click="OpenBackup_Click" IsEnabled="False" /><Button x:Name="AnotherGameButton" Content="Back to games" Click="AnotherGame_Click" /></WrapPanel>
        </StackPanel></ScrollViewer></Border>
        <Canvas x:Name="TransitionLayer" Visibility="Collapsed" IsHitTestVisible="False" ClipToBounds="True"><Rectangle x:Name="TransitionScan" Width="2" Fill="{StaticResource Accent}" Opacity="0.6"><Rectangle.Effect><DropShadowEffect Color="#57E7F7" BlurRadius="14" ShadowDepth="0" Opacity="0.7" /></Rectangle.Effect></Rectangle></Canvas>
      </Grid>
      <Border Grid.Row="4" Background="#0C1421" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="24,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0"><TextBlock x:Name="WizardStepText" Text="GAMES" Style="{StaticResource SectionLabel}" FontSize="9" Margin="0,0,0,4" /><TextBlock x:Name="StatusText" Text="Select a game" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" /><ProgressBar x:Name="BusyBar" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="0,6,0,0" /></StackPanel>
        <Button x:Name="WizardBackButton" Grid.Column="1" Content="Back" Click="WizardBack_Click" IsEnabled="False" MinWidth="96" /><Button x:Name="WizardNextButton" Grid.Column="2" Content="Set up" Click="WizardNext_Click" IsEnabled="False" MinWidth="158" Margin="0" Style="{StaticResource PrimaryButton}" /><Button x:Name="InstallButton" Grid.Column="2" Content="Install" Click="Install_Click" IsEnabled="False" MinWidth="158" Visibility="Collapsed" Margin="0" Style="{StaticResource PrimaryButton}" /><Button x:Name="WizardFinishButton" Grid.Column="2" Content="Close" Click="Close_Click" MinWidth="158" Visibility="Collapsed" Margin="0" Style="{StaticResource PrimaryButton}" />
      </Grid></Border>
    </Grid>
  </Border>
</Window>
